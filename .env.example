PORT=3000

# Netlify définit CONTEXT automatiquement.
# Ajoutez aussi SESSION_SECRET dans Site configuration > Environment variables.
SESSION_SECRET=changez-moi-avec-une-longue-cle-secrete-32-caracteres-minimum

# Changez obligatoirement ces valeurs avant la production.
ADMIN_USERNAME=votre_admin

# Option recommandee : mot de passe hashé.
# Commande : npm run hash-password -- "VotreMotDePasseTresFort"
ADMIN_PASSWORD_HASH=scrypt$remplacez$ceci

# Option simple si vous ne voulez pas utiliser de hash.
# ADMIN_PASSWORD=VotreMotDePasseTresFort

SESSION_TTL_MS=28800000
MAX_BODY_SIZE=52428800
LOGIN_WINDOW_MS=900000
LOGIN_MAX_ATTEMPTS=5
